# Production Environment Variables
# Note: Create React App requires REACT_APP_ prefix
REACT_APP_API_URL=https://api.fittrack.io.vn/api

# Emit the webpack runtime as an external file instead of an inline <script>.
# This lets the Content-Security-Policy (vercel.json) use a strict script-src
# WITHOUT 'unsafe-inline', which is what actually blocks injected inline scripts
# from reading the token in localStorage.
INLINE_RUNTIME_CHUNK=false
